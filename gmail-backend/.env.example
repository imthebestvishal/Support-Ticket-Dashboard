PORT=5000
MONGO_URI=mongodb://mongo:27017/gmail_app
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Create a real token at AgentRouter and keep it out of git.
AGENT_ROUTER_TOKEN=your-agent-router-token
# AgentRouter uses the Responses API at this base URL.
AGENT_ROUTER_MODEL=gpt-5.5
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_ROUTER_WIRE_API=auto
GMAIL_FETCH_LIMIT=25
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace_with_a_random_secret
