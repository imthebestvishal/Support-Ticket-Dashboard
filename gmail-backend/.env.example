PORT=5000
MONGO_URI=mongodb://mongo:27017/gmail_app
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
OPENAI_API_KEY=your_openai_api_key
FRONTEND_URL=http://localhost:5173
# Production examples:
# GOOGLE_REDIRECT_URI=https://support-ticket-dashboard-szpr.onrender.com/auth/google/callback
# FRONTEND_URL=https://your-active-vercel-domain.vercel.app
# Vercel frontend: VITE_API_URL=https://support-ticket-dashboard-szpr.onrender.com
SESSION_SECRET=replace_with_a_random_secret

# AI provider stack
# Groq is the primary provider. OpenRouter is the fallback. Do not commit real keys.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
